# --- Supabase ---
# Public: safe to expose to the browser (used by the anon client + Realtime).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: service role key. NEVER expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic (LLM moderation + summary) ---
# Server-only. Used by /api/moderate and /api/summarize.
ANTHROPIC_API_KEY=sk-ant-your-key
