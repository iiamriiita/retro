# --- Supabase ---
# Public: safe to expose to the browser (used by the anon client + Realtime).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: service role key. NEVER expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- 媽媽的行事曆 (/calendar) — Web Push 提醒 ---
# 產生金鑰:npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
# 排程呼叫 /api/calendar/cron 用的密鑰(自己取一串亂碼)
CRON_SECRET=your-cron-secret
# 選填:設定後進入 /calendar 要輸入通行碼(給家人用的簡單鎖)
# CALENDAR_PIN=1234

# --- Google Gemini (LLM moderation) ---
# Server-only. Used by /api/moderate. Optional — without it, moderation
# degrades to the keyword blocklist and lets answers through.
GEMINI_API_KEY=your-gemini-key
# Optional model override (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash
