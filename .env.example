# --- Supabase ---
# Public: safe to expose to the browser (used by the anon client + Realtime).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: service role key. NEVER expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google Gemini (LLM moderation) ---
# Server-only. Used by /api/moderate. Optional — without it, moderation
# degrades to the keyword blocklist and lets answers through.
GEMINI_API_KEY=your-gemini-key
# Optional model override (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash
